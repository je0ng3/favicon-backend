# EC2 의 /home/ubuntu/.env 템플릿. 실제 값은 넣지 않는다(.env 만 gitignore 대상).
# 배포 워크플로가 컨테이너를 건드리기 전에 .env 가 아래 키를 모두 갖고 있는지 검사하므로,
# 키를 추가/삭제하면 이 파일도 같이 고쳐야 한다.

# 프로필 / JPA
ACTIVE=prod
JPA_DDL=validate

# RDS
SPRING_RDS_URL=
SPRING_RDS_USERNAME=
SPRING_RDS_PASSWORD=

# Redis (compose 서비스명)
REDIS_HOST=redis

# 메일 (SMTP)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# AWS S3
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# 애플리케이션
JWT_SECRET=
API_KEY=
ADMIN_MAILS=

# ACTIVE=local 일 때만 필요(배포 검증 대상 아님): LOCAL_DB_URL, LOCAL_DB_USERNAME, LOCAL_DB_PASSWORD
